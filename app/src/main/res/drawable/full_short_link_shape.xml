<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="?attr/colorPrimaryContainer"
        android:endColor="?attr/colorSurfaceVariant"
        android:angle="45" />
    <corners android:radius="16dp" />
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="8dp"
        android:bottom="8dp" />
    <stroke
        android:color="?attr/colorOutlineVariant"
        android:width="1dp" />
</shape>
